<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10万元资金 · 中国商品期货 - A4实盘卡\n先活着，再赚钱"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/etSymbol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="品种代码（RB/M/MA）"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="当前收盘价"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etAtr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ATR"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etMa20Slope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="20日均线斜率（可正可负，不可为0）"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/etHigh20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="过去20日最高价"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etLow20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="过去20日最低价"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etGapAtr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="当日跳空（按ATR倍数，例如1.2）"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etConsecutiveLosses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="连续止损次数"
            android:inputType="number" />

        <Button
            android:id="@+id/btnEvaluate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="评估是否可开仓"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
